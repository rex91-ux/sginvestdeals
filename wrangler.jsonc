{
  // Must match the Worker name Cloudflare shows for this site exactly,
  // or `wrangler deploy` creates a second Worker and the live site stops updating.
  "name": "sginvestdeals",
  "compatibility_date": "2026-08-01",

  // Small script for the click counter: handles /api/* only; every other
  // request goes straight to the static files below.
  "main": "worker.js",
  // Static-assets-only Worker: the repo root is the site root.
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash"
  },

  // Shared click-count database for both sites (Cloudflare D1, free tier).
  "d1_databases": [
    { "binding": "DB", "database_name": "deals-clicks", "database_id": "4ecabdf7-f159-4c23-9471-bb2a53ac80fc" }
  ]
}
